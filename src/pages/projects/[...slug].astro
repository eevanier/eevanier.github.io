---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { marked } from 'marked';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import ProjectPhoto from '../../components/ProjectPhoto.astro';
import Lightbox from '../../components/Lightbox.astro';

export async function getStaticPaths() {
  // Hidden projects get no page at all.
  const projects = await getCollection('projects', ({ data }) => !data.hidden);
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const {
  title, tagline, tags, thumbnail, link, repository,
  summary, contributions, specs, highlights, gallery,
} = project.data;

const hasContributions = !!contributions?.length;
const hasSpecs = !!specs?.length;
const hasHighlights = !!highlights?.length;
const hasGallery = !!gallery?.length;
const hasNotes = (project.body ?? '').trim().length > 0;

const pad = (n: number) => String(n + 1).padStart(2, '0');
// Markdown → HTML. <!-- comments --> are stripped so TODO notes never go live.
const md = (text: string) =>
  marked.parse(text.replace(/<!--[\s\S]*?-->/g, ''), { async: false }) as string;
---

<ProjectLayout title={title}>
  <div class="space-y-12">
    <!-- Header -->
    <div class="space-y-8">
      <div class="space-y-4">
        <h1 class="text-4xl font-bold text-zinc-950">{title}</h1>
        <p class="text-zinc-500 text-lg">{tagline}</p>
        <div class="flex flex-wrap items-center gap-3">
          {tags.map((tag) => (
            <span class="text-xs font-mono bg-zinc-100 text-zinc-700 px-2 py-0.5 rounded border border-zinc-200">
              {tag}
            </span>
          ))}
        </div>
      </div>

      <!-- Hero image -->
      <div class="aspect-video w-full overflow-hidden rounded-lg border border-zinc-200 bg-zinc-100">
        <Image src={thumbnail} alt={title} class="w-full h-full object-cover" width={1280} height={720} />
      </div>

      <!-- Action buttons -->
      {(link || repository) && (
        <div class="flex gap-4">
          {link && (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-amber-600 text-white rounded hover:bg-amber-700 transition-colors"
            >
              Visit Project
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
            </a>
          )}
          {repository && (
            <a
              href={repository}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-white text-zinc-700 rounded hover:bg-zinc-50 transition-colors border border-zinc-200"
            >
              View Code
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
            </a>
          )}
        </div>
      )}
    </div>

    <!-- Summary + What I Did + Specs -->
    {(summary || hasContributions || hasSpecs) && (
      <div class={`grid grid-cols-1 gap-8 ${hasSpecs ? 'md:grid-cols-5' : ''}`}>
        <div class={`space-y-6 ${hasSpecs ? 'md:col-span-3' : ''}`}>
          {summary && <p class="text-lg text-zinc-700 leading-relaxed">{summary}</p>}

          {hasContributions && (
            <div class="space-y-4">
              <h2 class="text-sm font-mono text-amber-500 uppercase tracking-wider">What I Did</h2>
              <ol class="space-y-3">
                {contributions!.map((item, i) => (
                  <li class="flex gap-4">
                    <span class="font-mono text-sm text-amber-600 pt-0.5 shrink-0">{pad(i)}</span>
                    <span class="text-zinc-700 leading-relaxed">{item}</span>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </div>

        {hasSpecs && (
          <aside class="md:col-span-2 bg-zinc-50 border border-zinc-200 rounded-lg p-6 space-y-4 h-fit">
            <h2 class="text-sm font-mono text-amber-500 uppercase tracking-wider">Specs</h2>
            <dl class="divide-y divide-zinc-200">
              {specs!.map((s) => (
                <div class="flex justify-between gap-4 py-2 text-sm">
                  <dt class="font-mono text-zinc-500">{s.label}</dt>
                  <dd class="text-zinc-900 text-right font-medium">{s.value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )}
      </div>
    )}

    <!-- Technical Highlights -->
    {hasHighlights && (
      <section class="space-y-10">
        <h2 class="text-sm font-mono text-amber-500 uppercase tracking-wider border-b border-zinc-200 pb-3">
          Technical Highlights
        </h2>
        {highlights!.map((h, i) => (
          <article class="space-y-5">
            <div class="flex items-baseline gap-4">
              <span class="font-mono text-sm text-amber-600">{pad(i)}</span>
              <h3 class="text-2xl font-bold tracking-tight text-zinc-950">{h.title}</h3>
            </div>
            <div class="prose prose-zinc max-w-none pl-0 sm:pl-10" set:html={md(h.body)} />
            {h.images && h.images.length > 0 && (
              <div class={`grid gap-4 pl-0 sm:pl-10 ${h.images.length === 1 ? 'grid-cols-1' : 'grid-cols-2'}`}>
                {h.images.map((img, j) => (
                  <ProjectPhoto
                    src={img.src}
                    caption={img.caption}
                    alt={`${h.title} — image ${j + 1}`}
                    width={h.images!.length === 1 ? 1200 : 800}
                    wide={h.images!.length === 1}
                  />
                ))}
              </div>
            )}
          </article>
        ))}
      </section>
    )}

    <!-- Gallery -->
    {hasGallery && (
      <section class="space-y-4">
        <h2 class="text-sm font-mono text-amber-500 uppercase tracking-wider border-b border-zinc-200 pb-3">Gallery</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {gallery!.map((img, i) => (
            <ProjectPhoto src={img.src} caption={img.caption} alt={`${title} — photo ${i + 1}`} width={600} />
          ))}
        </div>
      </section>
    )}

    <!-- Optional free-form notes (the markdown body of the file) -->
    {hasNotes && (
      <article class="prose prose-zinc max-w-none border-t border-zinc-200 pt-8">
        <Content />
      </article>
    )}
  </div>
  <Lightbox />
</ProjectLayout>
