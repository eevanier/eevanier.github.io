---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

// Drone projects (tagged "Drones" or "FPV") come first, then everything else.
// Within each, newest first.
const DRONE_TAGS = ['Drones', 'FPV'];
const isDrone = (tags: string[]) => tags.some((t) => DRONE_TAGS.includes(t));

const allProjects = (await getCollection('projects', ({ data }) => !data.hidden)).sort((a, b) => {
  const droneOrder = Number(isDrone(b.data.tags)) - Number(isDrone(a.data.tags));
  return droneOrder || b.data.date.getTime() - a.data.date.getTime();
});
---

<Layout title="Projects" description="Browse all engineering and design projects — drones, mechanical design, robotics, and manufacturing work.">
  <section class="py-16 space-y-10">
    <div class="space-y-3 reveal">
      <p class="font-mono text-sm text-technical tracking-wider uppercase">
        Archive
      </p>
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tighter text-zinc-950">
        All Projects
      </h1>
      <p class="text-zinc-500 max-w-lg">
        A complete index of engineering and design work.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {allProjects.map((project) => (
        <div class="reveal">
          <ProjectCard project={project} />
        </div>
      ))}
    </div>
  </section>
</Layout>
